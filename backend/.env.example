# 后端环境变量模板（复制为 backend/.env 后生效）
# 完整字段说明：docs/02-后端/07-配置与安全.md

# 应用
APP_NAME=data-mid-platform
DEBUG=false
ENV=dev

# 数据库（双库隔离：TaskRepo / ArtifactRepo 各自独立库）
DATABASE_URL=mysql+pymysql://midplat:secret@127.0.0.1:3306/task_repo
ARTIFACT_DATABASE_URL=mysql+pymysql://midplat:secret@127.0.0.1:3306/artifact_repo

# Redis（事件总线桥 / 验证码共享 / 限流）
REDIS_URL=redis://127.0.0.1:6379/0
# 多副本部署：跨实例共享 WS 事件需开 true（本地单 worker 保持 false 即进程内广播）
EVENT_BUS_REDIS=false
EVENT_BUS_REDIS_CHANNEL=midplat.events

# Kafka（消息总线 / 实时流数据源）
KAFKA_BOOTSTRAP=127.0.0.1:9092
KAFKA_TOPIC=task.events

# MinIO（制品文件）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts
MINIO_REGION=us-east-1

# LLM（OpenAI 兼容）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
# provider 级韧性：单次请求超时(秒) + 客户端内置重试次数
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# 认证（JWT + 三档角色 + 表级 ACL）
# 生产环境必须使用至少 32 位随机字符串，禁止沿用模板值（ENV=prod 时启动会强校验）
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=120
PASSWORD_HASHER=argon2

# 商业版初始管理员（仅当库中不存在启用的管理员时生效；留空则需运行 CLI 初始化）
# 初始化：python -m app.cli create-admin --username admin
# 重置口令：python -m app.cli reset-password --username admin
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_MIN_LENGTH=10

# 登录防爆破（账号 / 来源 IP 双维度；Redis 多实例共享，不可用时内存兜底）
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_LOCKOUT_SECONDS=900

# CORS（前端地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 业务阈值（取数引擎：单次只读 SELECT 行数上限，超出截断并标注）
MAX_QUERY_ROWS=5000

# 调度租约/心跳（多 worker + 崩溃自愈；单位秒）
SCHEDULER_LEASE_TTL=120
SCHEDULER_SCAN_INTERVAL=1.0
SCHEDULER_MAX_CONCURRENT=4
LLM_INPUT_MAX_CHARS=12000

# 异步执行：单节点并发拉取上游资产的会话上限
AGENT_INPUT_FETCH_CONCURRENCY=4
