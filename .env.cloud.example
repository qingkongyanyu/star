# compose.cloud.yml 的环境变量模板
# 用法：复制为 .env（与 compose.cloud.yml 同目录，compose 自动读取）后
#       `docker compose -f compose.cloud.yml up -d --build`
# 生产务必：强随机 JWT_SECRET + 真实 LLM key + ENV=prod + 独立数据库/MinIO 口令

# ---- 必填（缺失时 compose 会直接报错，避免带着默认口令上线）----
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
LLM_API_KEY=sk-replace-with-your-provider-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=qwen-plus

# 初始管理员（仅首次启动、库中无管理员时创建；创建后可从 .env 移除口令）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
PASSWORD_MIN_LENGTH=10

# 数据库 / 对象存储口令（请使用随机值，不要沿用本地开发默认）
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_APP_PASSWORD=replace-with-a-strong-app-password
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# 前端访问来源（生产必须显式设置，逗号分隔）
CORS_ORIGINS=https://your-domain.example.com

# ---- 建议覆盖（当前默认指向 compose 服务名）----
ENV=prod
REDIS_URL=redis://redis:6379/0
EVENT_BUS_REDIS=true
MINIO_ENDPOINT=minio:9000
EMBEDDING_MODEL=text-embedding-v3

# 登录防爆破 / 异步执行
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_LOCKOUT_SECONDS=900
AGENT_INPUT_FETCH_CONCURRENCY=4
